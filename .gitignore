# 运行时生成：仅忽略仓库根目录的 SQLite 数据库 + 日志。
# 必须锚定为 /data/，否则会误伤 stock_tracker/**/data 等源码包。
/data/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 虚拟环境
venv/
.venv/

# 本地环境变量 / 密钥
.env

# 编辑器 / OS
.vscode/
.DS_Store
Thumbs.db

# Windows 保留设备名，某些工具会把它误显示为未跟踪路径
/nul

# 安装器下载的浏览器（Playwright 开发期依赖，非运行时）
.playwright/

# Agent 工作记忆（非项目源码，绝不入库）
.workbuddy/

# Node 依赖（qa/ 下的测试工具依赖，非运行时）
node_modules/

# Playwright 可视化验证截图产物（非源码）
qa/ui/shots/
/qa/shots/today-*.png
/qa/shots/page-*.png
/qa/shots/today-shot-report.json
