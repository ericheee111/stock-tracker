# Exact-raw research fixtures are content-addressed. Keep their repository,
# checkout, archive, and CI bytes identical across Windows and Unix hosts.
tests_quant/fixtures/**/*.json text eol=lf
tests_quant/fixtures/**/*.html text eol=lf
tests_quant/fixtures/**/*.csv text eol=lf
tests_quant/fixtures/**/*.toml text eol=lf
tests_quant/fixtures/**/*.md text eol=lf
tests_quant/fixtures/**/*.txt text eol=lf
tests_quant/fixtures/**/*.pdf binary

# Frozen numerical fixture bytes must be stable across Windows checkouts.
tests/fixtures/numerical_legacy_v1.json text eol=lf
tests/fixtures/numerical_baselines_v1.json text eol=lf
